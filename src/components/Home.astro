---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { projects } from '../data/projects';
import { t, projectHref, homeHref, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const altLang: Lang = lang === 'en' ? 'pt' : 'en';
const heroNodes = projects.map((p) => ({ slug: p.slug, num: p.num, title: p.title[lang], href: projectHref(lang, p.slug) }));
---
<Base lang={lang} altHref={homeHref(altLang)}>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="mono caps">{SITE.location[lang]}</p>
      <h1>{SITE.name}</h1>
      <p class="role">{s.role}</p>
      <p class="lede">{s.lede}</p>
    </div>
    <figure class="hero-fig">
      <div class="hero-canvas" id="hero" data-nodes={JSON.stringify(heroNodes)}>
        <noscript><p class="mono">{s.noWebgl}</p></noscript>
      </div>
      <figcaption class="fig-caption">{s.figHero}</figcaption>
    </figure>
  </section>

  <section id="work" class="wrap section">
    <div class="section-head">
      <h2>{s.index}</h2>
      <span class="mono">{projects.length.toString().padStart(2, '0')}</span>
    </div>
    <hr class="rule" />
    <ol class="index">
      {projects.map((p) => (
        <li>
          <a class="index-row" href={projectHref(lang, p.slug)}>
            <span class="index-num mono">{p.num}</span>
            <span class="index-main">
              <span class="index-kicker mono caps">{p.kicker[lang]}</span>
              <span class="index-title">{p.title[lang]}</span>
              <span class="index-tagline">{p.tagline[lang]}</span>
            </span>
            <span class="index-meta">
              <span class:list={['tag', p.status === 'building' && 'tag--red']}>{s.status[p.status]}</span>
              <span class="index-arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section id="about" class="wrap section about">
    <h2>{s.about}</h2>
    <div>
      <p class="about-body">{s.aboutBody}</p>
      <p class="mono">
        {s.contact}:{' '}
        {SITE.email && <><a href={`mailto:${SITE.email}`}>{SITE.email}</a> · </>}
        <a href={SITE.linkedin} rel="me">LinkedIn</a> · <a href={SITE.github} rel="me">GitHub</a>
      </p>
    </div>
  </section>
</Base>

<script>
  import { mountHero } from '../scenes/hero';
  import { webglAvailable } from '../scenes/common';
  const el = document.getElementById('hero');
  if (el && webglAvailable()) mountHero(el, JSON.parse(el.dataset.nodes!));
  else el?.classList.add('no-webgl');
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(24px, 4vw, 56px) 24px;
  }
  .role {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    margin: 14px 0 22px;
    color: var(--red-ink);
  }
  .lede { color: var(--ink-2); font-size: 1.05rem; }
  .hero-fig { margin: 0; }
  .hero-canvas {
    position: relative;
    aspect-ratio: 5 / 4;
    max-width: 100%;
    touch-action: pan-y;
    cursor: grab;
  }
  .hero-canvas :global(canvas) { width: 100% !important; height: 100% !important; }
  .hero-canvas.no-webgl { aspect-ratio: auto; }
  .hero-canvas :global(.hero-labels) { position: absolute; inset: 0; pointer-events: none; }
  .hero-canvas :global(.hero-label) {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    max-width: 150px;
    text-align: center;
    text-decoration: none;
    font: 0.74rem/1.25 var(--sans);
    color: var(--ink-2);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    padding: 3px 6px;
  }
  .hero-canvas :global(.hero-label-num) { font-family: var(--mono); color: var(--muted); }
  .hero-canvas :global(.hero-label.is-active) { color: var(--red-ink); }
  .hero-canvas :global(.hero-label.is-active .hero-label-num) { color: var(--red-ink); }

  .section { margin-top: clamp(64px, 9vw, 120px); }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 14px; }

  .index { list-style: none; margin: 0; padding: 0; }
  .index li { border-bottom: 1px solid var(--rule); }
  .index-row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 20px;
    padding: 26px 0;
    text-decoration: none;
    align-items: start;
  }
  .index-row:hover { color: inherit; }
  .index-num { padding-top: 6px; }
  .index-main { display: flex; flex-direction: column; gap: 6px; }
  .index-title {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.1;
    font-variation-settings: 'opsz' 72;
  }
  .index-tagline { color: var(--ink-2); max-width: 62ch; }
  .index-meta { display: flex; gap: 16px; align-items: center; padding-top: 4px; }
  .index-arrow { font-size: 1.4rem; transition: transform 0.2s ease; }
  .index-row:hover .index-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; }
  .index-row:hover .index-arrow { transform: translateX(6px); color: var(--red); }

  .about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); }
  .about-body { font-family: var(--serif); font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.4; }

  @media (max-width: 560px) {
    .hero-canvas :global(.hero-label-title) { display: none; }
    .hero-canvas :global(.hero-label-num) { font-size: 0.85rem; color: var(--ink); }
  }
  @media (max-width: 820px) {
    .hero, .about { grid-template-columns: 1fr; }
    .hero-canvas { aspect-ratio: 6 / 5; }
    .index-row { grid-template-columns: 36px minmax(0, 1fr); }
    .index-meta { grid-column: 2; }
  }
</style>
