---
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;

const S = {
  en: {
    strategy: 'Join strategy', pit: 'Point-in-time', latest: 'Latest value (naive)', ttl: 'Feature TTL', days: 'days', reset: 'Reset labels',
    drag: 'Drag a flag along the timeline to move its label · drag the background to orbit',
    now: 'now: dataset extracted', churn: 'churned', stayed: 'stayed',
    registry: 'Registry entry', rows: 'Training rows this join produces',
    cust: 'Customer', label: 'Label', value: 'purchases_30d', from: 'Value from', status: 'Status',
    ok: '✓ valid', leak: '▲ leak: value from after the label', stale: '○ missing: older than TTL',
    exp: 'The experiment', expLede: 'Same synthetic customers, same model (logistic regression on 3 features), two ways of building the training set. “Offline” is the validation score you would report; “production” is how the model actually scores when, at prediction time, only the past exists.',
    run: 'Run the experiment', rerun: 'Run again with new data',
    offline: 'Offline (validation)', production: 'Production', chance: 'coin flip (0.5)',
    auc: 'AUC',
    try: 'Things to try',
    lessons: [
      'Switch to “Latest value”: every join line that reaches past its flag turns red. Those rows teach the model what churn looks like after it already happened.',
      'Drag C-102’s flag left and right: the point-in-time join always picks the last bar strictly before it, never one after.',
      'Lower the TTL until C-104 loses its value: a stale feature becomes missing instead of silently pretending to be fresh.',
      'Run the experiment: the leaky model looks perfect offline and collapses to a coin flip in production. Nothing in the offline metrics warns you.',
    ],
  },
  pt: {
    strategy: 'Estratégia de join', pit: 'Point-in-time', latest: 'Último valor (ingênuo)', ttl: 'TTL da feature', days: 'dias', reset: 'Reiniciar rótulos',
    drag: 'Arraste uma bandeira pela linha do tempo para mover o rótulo · arraste o fundo para girar',
    now: 'agora: dataset extraído', churn: 'cancelou', stayed: 'ficou',
    registry: 'Entrada no registro', rows: 'Linhas de treino que este join produz',
    cust: 'Cliente', label: 'Rótulo', value: 'purchases_30d', from: 'Valor do dia', status: 'Estado',
    ok: '✓ válido', leak: '▲ vazamento: valor de depois do rótulo', stale: '○ ausente: mais velho que o TTL',
    exp: 'O experimento', expLede: 'Os mesmos clientes sintéticos, o mesmo modelo (regressão logística com 3 features), duas formas de montar o conjunto de treino. “Offline” é o score de validação que você reportaria; “produção” é como o modelo realmente se sai quando, na hora de prever, só existe o passado.',
    run: 'Rodar o experimento', rerun: 'Rodar de novo com novos dados',
    offline: 'Offline (validação)', production: 'Produção', chance: 'cara ou coroa (0,5)',
    auc: 'AUC',
    try: 'O que experimentar',
    lessons: [
      'Troque para “Último valor”: toda ligação que passa da sua bandeira fica vermelha. Essas linhas ensinam ao modelo como é o churn depois que ele já aconteceu.',
      'Arraste a bandeira do C-102 para os lados: o join point-in-time sempre pega a última barra estritamente antes dela, nunca uma depois.',
      'Baixe o TTL até o C-104 perder o valor: uma feature velha vira ausente em vez de fingir que está fresca.',
      'Rode o experimento: o modelo com vazamento parece perfeito offline e desaba para cara ou coroa em produção. Nada nas métricas offline avisa.',
    ],
  },
}[lang];
---
<div class="demo" id="fs-demo" data-s={JSON.stringify(S)} data-lang={lang}>
  <div class="controls fs-controls">
    <div class="field">
      <span class="mono">{S.strategy}</span>
      <div class="seg" role="radiogroup" aria-label={S.strategy}>
        <label><input type="radio" name="strategy" value="pit" checked /><span>{S.pit}</span></label>
        <label><input type="radio" name="strategy" value="latest" /><span>{S.latest}</span></label>
      </div>
    </div>
    <label>
      <span class="mono">{S.ttl} <output data-out="ttl">30 {S.days}</output></span>
      <input type="range" name="ttl" min="5" max="60" step="1" value="30" />
    </label>
    <button type="button" class="btn btn--ghost" data-reset>{S.reset}</button>
  </div>

  <div>
    <div class="stage-canvas fs-canvas" data-canvas></div>
    <p class="mono stage-note">{S.drag}</p>
  </div>

  <div class="fs-lower">
    <aside class="registry">
      <h3 class="mono caps">{S.registry}</h3>
      <pre><code><span class="k">feature</span>: purchases_30d
<span class="k">entity</span>:  customer_id
<span class="k">source</span>:  orders.event_time
<span class="k">join</span>:    <span data-reg-join>point_in_time</span>
<span class="k">ttl</span>:     <span data-reg-ttl>30d</span>
<span class="k">online</span>:  redis (latest)
<span class="k">offline</span>: parquet (full history)</code></pre>
    </aside>
    <div class="rows">
      <h3 class="mono caps">{S.rows}</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>{S.cust}</th><th>{S.label}</th><th class="mono">{S.value}</th><th>{S.from}</th><th>{S.status}</th></tr></thead>
          <tbody data-rows></tbody>
        </table>
      </div>
    </div>
  </div>

  <section class="exp">
    <h3>{S.exp}</h3>
    <p class="exp-lede">{S.expLede}</p>
    <button type="button" class="btn" data-run>{S.run}</button>
    <div class="exp-out" data-exp hidden>
      <div class="legend mono">
        <span><i class="sw sw-ink"></i>{S.pit}</span>
        <span><i class="sw sw-red"></i>{S.latest}</span>
      </div>
      <div class="slope" data-slope></div>
      <p class="mono" data-exp-note></p>
    </div>
  </section>

  <div class="try">
    <h3>{S.try}</h3>
    <ol>{S.lessons.map((l) => <li>{l}</li>)}</ol>
  </div>
</div>

<script>
  import { sampleCustomers, runExperiment, type JoinResult, type Strategy } from '../scenes/fs-sim';
  import { mountFs } from '../scenes/fs';
  import { webglAvailable } from '../scenes/common';

  const root = document.getElementById('fs-demo')!;
  const S = JSON.parse(root.dataset.s!);
  const pt = root.dataset.lang === 'pt';
  const locale = pt ? 'pt-BR' : 'en-US';
  const nf = (n: number, d = 0) => n.toLocaleString(locale, { minimumFractionDigits: d, maximumFractionDigits: d });

  const customers = sampleCustomers();
  const initialDays = customers.map((c) => c.labelDay);
  const state = { strategy: 'pit' as Strategy, ttl: 30 };

  // Tabela das linhas de treino.
  const tbody = root.querySelector<HTMLElement>('[data-rows]')!;
  function renderRows(results: JoinResult[]) {
    tbody.innerHTML = results
      .map((r, i) => {
        const c = customers[i];
        const cls = r.status === 'leak' ? 'leak' : r.status === 'stale' ? 'stale' : '';
        return `<tr class="${cls}">
          <td class="mono">${c.id}</td>
          <td>${c.churned ? S.churn : S.stayed} · d${c.labelDay}</td>
          <td class="num">${r.event ? r.event.value : 'null'}</td>
          <td class="mono">${r.event ? `d${r.event.day}` : r.candidate ? `(d${r.candidate.day})` : '—'}</td>
          <td>${S[r.status]}</td></tr>`;
      })
      .join('');
  }

  // Registro: reflete a configuração atual.
  const regJoin = root.querySelector('[data-reg-join]')!;
  const regTtl = root.querySelector('[data-reg-ttl]')!;
  const ttlOut = root.querySelector('[data-out="ttl"]')!;
  let view: { update: () => void } | null = null;
  const refresh = () => {
    regJoin.textContent = state.strategy === 'pit' ? 'point_in_time' : `latest   # ${pt ? 'vaza!' : 'leaks!'}`;
    regTtl.textContent = `${state.ttl}d`;
    ttlOut.textContent = `${state.ttl} ${S.days}`;
    view ? view.update() : renderRows(customers.map((c) => ({ event: null, candidate: null, status: 'ok' })));
  };
  root.querySelectorAll<HTMLInputElement>('input[name=strategy]').forEach((r) =>
    r.addEventListener('change', () => {
      state.strategy = r.value as Strategy;
      refresh();
    }),
  );
  root.querySelector<HTMLInputElement>('input[name=ttl]')!.addEventListener('input', (e) => {
    state.ttl = Number((e.target as HTMLInputElement).value);
    refresh();
  });
  root.querySelector('[data-reset]')!.addEventListener('click', () => {
    customers.forEach((c, i) => (c.labelDay = initialDays[i]));
    refresh();
  });

  const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
  if (webglAvailable()) {
    view = mountFs(canvas, customers, state, renderRows, { now: S.now, churn: S.churn, stayed: S.stayed });
  } else {
    canvas.innerHTML = `<p class="mono">${pt ? 'WebGL indisponível: a tabela e o experimento abaixo continuam funcionando.' : 'WebGL unavailable: the table and experiment below still work.'}</p>`;
    // Sem a cena, a tabela é recalculada direto.
    import('../scenes/fs-sim').then(({ join }) => {
      view = { update: () => renderRows(customers.map((c) => join(c, state.strategy, state.ttl))) };
      view.update();
    });
  }
  refresh();

  // Experimento + gráfico de inclinação (slope chart) em SVG.
  const runBtn = root.querySelector<HTMLButtonElement>('[data-run]')!;
  const out = root.querySelector<HTMLElement>('[data-exp]')!;
  const slope = root.querySelector<HTMLElement>('[data-slope]')!;
  const note = root.querySelector<HTMLElement>('[data-exp-note]')!;
  let runs = 0;
  runBtn.addEventListener('click', () => {
    runBtn.disabled = true;
    // Deixa o botão repintar antes do cálculo (≈100 ms).
    setTimeout(() => {
      const r = runExperiment(4000, 7 + runs * 31);
      runs++;
      drawSlope(r);
      note.textContent = pt
        ? `Treinado e avaliado com ${nf(r.n)} clientes em ${nf(r.ms)} ms, no seu navegador.`
        : `Trained and evaluated on ${nf(r.n)} customers in ${nf(r.ms)} ms, in your browser.`;
      out.hidden = false;
      runBtn.disabled = false;
      runBtn.textContent = S.rerun;
    }, 30);
  });

  function drawSlope(r: ReturnType<typeof runExperiment>) {
    const W = 560, H = 280, L = 170, R = 410, T = 20, B = 30;
    const y = (v: number) => T + ((1 - v) / (1 - 0.4)) * (H - T - B);
    const grid = [0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1.0]
      .map((v) => `<line x1="${L - 70}" x2="${R + 50}" y1="${y(v)}" y2="${y(v)}" class="${v === 0.5 ? 'chance' : 'g'}"/>
        <text x="${L - 78}" y="${y(v) + 4}" text-anchor="end" class="ax">${nf(v, 1)}</text>`)
      .join('');
    const series = [
      { key: 'pit', name: S.pit, cls: 'ink', d: r.pit },
      { key: 'latest', name: S.latest, cls: 'red', d: r.latest },
    ];
    const lines = series
      .map((s) => `
        <line x1="${L}" x2="${R}" y1="${y(s.d.offline)}" y2="${y(s.d.production)}" class="s s-${s.cls}"/>
        <circle cx="${L}" cy="${y(s.d.offline)}" r="5" class="p p-${s.cls}"><title>${s.name} · ${S.offline}: ${S.auc} ${nf(s.d.offline, 3)}</title></circle>
        <circle cx="${R}" cy="${y(s.d.production)}" r="5" class="p p-${s.cls}"><title>${s.name} · ${S.production}: ${S.auc} ${nf(s.d.production, 3)}</title></circle>
        <text x="${L - 12}" y="${y(s.d.offline) + 4}" text-anchor="end" class="v">${nf(s.d.offline, 2)}</text>
        <text x="${R + 12}" y="${y(s.d.production) + 4}" class="v">${nf(s.d.production, 2)}</text>`)
      .join('');
    slope.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${S.auc}: ${S.offline} → ${S.production}">
      ${grid}
      <text x="${L + 14}" y="${y(0.5) - 6}" class="ax">${S.chance}</text>
      ${lines}
      <text x="${L}" y="${H - 8}" text-anchor="middle" class="xl">${S.offline}</text>
      <text x="${R}" y="${H - 8}" text-anchor="middle" class="xl">${S.production}</text>
      <text x="${L - 78}" y="10" text-anchor="end" class="ax">${S.auc}</text>
    </svg>
    <table class="visually-hidden"><tr><th></th><th>${S.offline}</th><th>${S.production}</th></tr>
      ${series.map((s) => `<tr><th>${s.name}</th><td>${nf(s.d.offline, 3)}</td><td>${nf(s.d.production, 3)}</td></tr>`).join('')}</table>`;
  }
</script>

<style>
  .field { display: flex; flex-direction: column; gap: 8px; }
  .fs-controls { grid-template-columns: auto minmax(180px, 1fr) auto; }
  .fs-canvas { cursor: grab; }
  .fs-canvas :global(.fs-tick) { font: 0.66rem var(--mono); color: var(--muted); }
  .fs-canvas :global(.fs-flag) { display: flex; flex-direction: column; font: 0.7rem/1.2 var(--sans); background: color-mix(in srgb, var(--paper) 85%, transparent); padding: 1px 4px; }
  .fs-canvas :global(.fs-flag span) { font-family: var(--mono); color: var(--muted); font-size: 0.64rem; }

  .fs-lower { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: 32px; align-items: start; }
  .fs-lower h3, .exp h3 { margin-bottom: 12px; }
  .fs-lower h3 { font-size: 0.78rem; }
  .registry pre {
    margin: 0; padding: 16px 18px; background: var(--ink); color: var(--paper);
    font: 0.8rem/1.7 var(--mono); overflow-x: auto;
  }
  .registry .k { color: #b9b2a3; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { text-align: left; font: 0.72rem var(--mono); color: var(--muted); font-weight: 400; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--ink); }
  td { padding: 9px 12px 9px 0; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  td.num { font-variant-numeric: tabular-nums; font-family: var(--mono); }
  tr.leak td:last-child, tr.leak td.num { color: var(--red-ink); }
  tr.stale td { color: var(--muted); }

  .exp { border-top: 1px solid var(--ink); padding-top: 18px; }
  .exp-lede { color: var(--ink-2); max-width: 75ch; }
  .exp-out { margin-top: 20px; max-width: 640px; }
  .legend { display: flex; gap: 20px; margin-bottom: 8px; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .sw { display: inline-block; width: 18px; height: 2px; }
  .sw-ink { background: var(--ink); }
  .sw-red { background: var(--red); }
  .slope :global(svg) { width: 100%; height: auto; overflow: visible; }
  .slope :global(.g) { stroke: var(--rule); }
  .slope :global(.chance) { stroke: var(--muted); stroke-dasharray: 4 4; }
  .slope :global(.ax) { font: 10px var(--mono); fill: var(--muted); }
  .slope :global(.xl) { font: 12px var(--sans); fill: var(--ink-2); }
  .slope :global(.v) { font: 600 13px var(--mono); fill: var(--ink); }
  .slope :global(.s) { stroke-width: 2; }
  .slope :global(.s-ink) { stroke: var(--ink); }
  .slope :global(.s-red) { stroke: var(--red); }
  .slope :global(.p) { stroke: var(--paper); stroke-width: 2; }
  .slope :global(.p-ink) { fill: var(--ink); }
  .slope :global(.p-red) { fill: var(--red); }

  @media (max-width: 960px) {
    .fs-controls { grid-template-columns: 1fr; }
    .fs-lower { grid-template-columns: 1fr; }
  }
</style>
