---
import type { ArchNode } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props { nodes: ArchNode[]; edges: [string, string][]; lang: Lang; title: string }
const { nodes, edges, lang, title } = Astro.props;

const BW = 150, BH = 56, CG = 46, RG = 34, PAD = 12;
const pos = (n: ArchNode) => ({ x: PAD + n.col * (BW + CG), y: PAD + n.row * (BH + RG) });
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const W = PAD * 2 + (Math.max(...nodes.map((n) => n.col)) + 1) * (BW + CG) - CG;
const H = PAD * 2 + (Math.max(...nodes.map((n) => n.row)) + 1) * (BH + RG) - RG;

// Roteamento ortogonal simples: horizontal entre colunas, vertical na mesma coluna.
const paths = edges.map(([a, b]) => {
  const A = pos(byId[a]), B = pos(byId[b]);
  if (byId[a].col === byId[b].col) {
    const down = B.y > A.y;
    const x = A.x + BW / 2;
    return `M${x},${down ? A.y + BH : A.y} V${down ? B.y - 4 : B.y + BH + 4}`;
  }
  const sx = A.x + BW, sy = A.y + BH / 2, ex = B.x - 4, ey = B.y + BH / 2;
  const mx = sx + CG / 2;
  return sy === ey ? `M${sx},${sy} H${ex}` : `M${sx},${sy} H${mx} V${ey} H${ex}`;
});
---
<div class="arch">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} role="img" aria-label={title}>
    <defs>
      <marker id="arrow" viewBox="0 0 8 8" refX="4" refY="4" markerWidth="8" markerHeight="8" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="currentColor" />
      </marker>
    </defs>
    {paths.map((d) => <path d={d} class="edge" marker-end="url(#arrow)" />)}
    {nodes.map((n) => {
      const p = pos(n);
      return (
        <g transform={`translate(${p.x},${p.y})`}>
          <rect width={BW} height={BH} class="node" />
          <text x={12} y={24} class="node-label">{n.label}</text>
          <text x={12} y={42} class="node-sub">{n.sub[lang]}</text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  .arch { overflow-x: auto; padding-bottom: 6px; color: var(--ink); }
  svg { max-width: none; height: auto; }
  @media (min-width: 900px) { svg { max-width: 100%; } }
  .edge { fill: none; stroke: currentColor; stroke-width: 1.25; }
  .node { fill: var(--paper); stroke: var(--ink); stroke-width: 1.25; }
  .node-label { font: 600 14px var(--sans); fill: var(--ink); }
  .node-sub { font: 11px var(--mono); fill: var(--muted); }
</style>
